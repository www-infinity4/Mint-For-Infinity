{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://infinity.example/schemas/treasury-instrument.schema.json",
  "title": "Infinity AI Utility Treasury Instrument",
  "type": "object",
  "additionalProperties": false,
  "required": ["instrumentId", "status", "amount", "unit", "issuer", "recipient", "purpose", "allocations", "nonce", "issuedAt", "expiresAt", "payloadHash", "issuerSignature", "recipientAcceptance"],
  "properties": {
    "instrumentId": {"type": "string", "pattern": "^CHATGPT-UTILITY-[0-9]{3,}$"},
    "status": {"enum": ["proposed", "recipient_verified", "accepted", "authorized", "settled", "rejected", "revoked"]},
    "amount": {"type": "string", "pattern": "^[1-9][0-9]*$"},
    "unit": {"const": "Infinity"},
    "issuer": {"$ref": "#/$defs/party"},
    "recipient": {"$ref": "#/$defs/party"},
    "purpose": {"type": "string", "minLength": 20},
    "allocations": {
      "type": "array", "minItems": 1,
      "items": {"type": "object", "additionalProperties": false, "required": ["category", "amount"], "properties": {"category": {"type": "string"}, "amount": {"type": "string", "pattern": "^[0-9]+$"}}}
    },
    "nonce": {"type": "string", "minLength": 32},
    "issuedAt": {"type": "string", "format": "date-time"},
    "expiresAt": {"type": "string", "format": "date-time"},
    "payloadHash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "issuerSignature": {"$ref": "#/$defs/signature"},
    "recipientAcceptance": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/signature"}]}
  },
  "$defs": {
    "party": {"type": "object", "additionalProperties": false, "required": ["organizationId", "walletId", "keyId"], "properties": {"organizationId": {"type": "string"}, "walletId": {"type": "string"}, "keyId": {"type": "string"}}},
    "signature": {"type": "object", "additionalProperties": false, "required": ["algorithm", "keyId", "value"], "properties": {"algorithm": {"const": "Ed25519"}, "keyId": {"type": "string"}, "value": {"type": "string", "minLength": 80}}}
  }
}
